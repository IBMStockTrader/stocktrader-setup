# Terraform
# NOTE: .terraform.lock.hcl is intentionally tracked in git.
# This ensures reproducible provider versions across team members and CI,
# and allows Dependabot to detect provider version updates.
**/.terraform/*
*.tfvars
*.tfvars.json
terraform.tfstate
terraform.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
*.tfplan.*

# Terraform-generated module artefacts
modules/function_app/build/*
modules/postgres_init/*
modules/apply_cr/*_stock-trader.yaml
modules/apply_cr/*_${namespace}.yaml

# Certificates and private keys
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.p7b
*.p7c
*.p8
*.p8a

# Environment and local config
.env
.env.*
output.txt

# Terraform CLI config
.terraformrc
terraform.rc

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local outputs or artifacts
output.txt

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
